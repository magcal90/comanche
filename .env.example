# Local-development values only. Copy to .env to override Compose defaults.
# Do not reuse these credentials outside an isolated developer environment.
COMANCHE_KAFKA_PORT=29092
COMANCHE_MQTT_PORT=1883
COMANCHE_MQTT_USERNAME=comanche-local
COMANCHE_MQTT_PASSWORD=comanche-local

# IoT Gateway (use the local broker identity until per-service ACL provisioning is enabled)
COMANCHE_GATEWAY_MQTT_ENABLED=true
COMANCHE_MQTT_SERVER_URI=tcp://localhost:1883
COMANCHE_GATEWAY_MQTT_CLIENT_ID=comanche-iot-gateway-local-1
COMANCHE_GATEWAY_MQTT_USERNAME=comanche-local
COMANCHE_GATEWAY_MQTT_PASSWORD=comanche-local
COMANCHE_REGISTERED_DEVICE_IDS=KIOSK-TAM-003,POS-TAM-001
COMANCHE_POSTGRES_PORT=5432
COMANCHE_POSTGRES_DB=comanche
COMANCHE_POSTGRES_USER=comanche
COMANCHE_POSTGRES_PASSWORD=comanche-local
